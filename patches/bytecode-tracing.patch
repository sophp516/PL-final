+  bct_counts = make_hash_table (&hashtest_eq, DEFAULT_HASH_SIZE,
+				Weak_None, false);
+  staticpro (&bct_counts);
+  bct_cached_fun = Qnil;
+  bct_cached_cell = Qnil;
+  staticpro (&bct_cached_fun);
+  staticpro (&bct_cached_cell);
+  defsubr (&Sbytecode_trace_start);
+  defsubr (&Sbytecode_trace_stop);
+  defsubr (&Sbytecode_trace_reset);
+  defsubr (&Sbytecode_trace_counts);
+
 #ifdef BYTE_CODE_METER
 
   DEFVAR_LISP ("byte-code-meter", Vbyte_code_meter,
